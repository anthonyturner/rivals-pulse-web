{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "dist/rivals-pulse-coach/browser",
  "redirects": [
    { "source": "/overlay-faq", "destination": "/faq", "permanent": true },
    { "source": "/overlay-faq/", "destination": "/faq", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/api/ssr"
    }
  ],
  "functions": {
    "api/admin/data-jobs-run.ts": { "maxDuration": 60 },
    "api/ssr.mjs": {
      "maxDuration": 15,
      "includeFiles": "dist/rivals-pulse-coach/{server/**,browser/index.csr.html}"
    }
  },
  "crons": [
    {
      "path": "/api/sync/home-news",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/api/glossary",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    },
    {
      "source": "/api/heroes",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
