# Copy this file to .env for local-only settings.
# Do not put real secrets in this example file.

# Server port used by the built SSR server.
PORT=4000

# Shared Turso database used by local development and production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase project the server reads and writes. Use a secret key (sb_secret_...),
# never the publishable key. Server-only: never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The publishable key (sb_publishable_...) for the same project. /api/hero-stats reads the hero
# aggregates with it through a function that returns counts only, and the Discord sign-in
# (/api/auth/*) calls Supabase Auth with it.
SUPABASE_PUBLISHABLE_KEY=

# Answering Needs Tony items from Slack (POST /api/slack/events); see docs/agent-workflows/tony-answers.md.
# Set these on the Vercel project. The signing secret, bot token and GitHub token are secrets.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_TONY_USER_ID=
SLACK_NEEDS_TONY_CHANNEL_ID=
# A fine-grained token of Tony's own GitHub account with Issues read and write on both Rivals Pulse repositories.
TONY_ANSWER_GITHUB_TOKEN=
